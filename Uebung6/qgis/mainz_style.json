      "paint": {
        "fill-color": "#e31a1c",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-400",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          400
        ]
      ],
      "paint": {
        "fill-color": "#800026",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "buildings-none",
      "type": "fill",
      "source": "buildings",
      "source-layer": "buildings",
      "filter": [
        "any",
        [
          "!has",
          "building:levels"
        ],
        [
          "in",
          "building:levels",
          "-1",
          "0",
          "0.5"
        ]
      ],
      "paint": {
        "fill-color": "#bdbdbd",
        "fill-opacity": 0.85,
        "fill-outline-color": "#ffffff"
      }
    },
    {
      "id": "buildings-1-2",
      "type": "fill",
      "source": "buildings",
      "source-layer": "buildings",
      "filter": [
        "in",
        "building:levels",
        "1",
        "1.3",
        "1.5",
        "2"
      ],
      "paint": {
        "fill-color": "#9ecae1",
        "fill-opacity": 0.85,
        "fill-outline-color": "#ffffff"
      }
    },
    {
      "id": "buildings-3-4",
      "type": "fill",
      "source": "buildings",
      "source-layer": "buildings",
      "filter": [
        "in",
        "building:levels",
        "3",
        "3.5",
        "4",
        "4.5"
      ],
      "paint": {
        "fill-color": "#4292c6",
        "fill-opacity": 0.85,
        "fill-outline-color": "#ffffff"
      }
    },
    {
      "id": "buildings-5+",
      "type": "fill",
      "source": "buildings",
      "source-layer": "buildings",
      "filter": [
        "in",
        "building:levels",
        "10",
        "11",
