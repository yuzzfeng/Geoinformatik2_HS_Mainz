{
  "version": 8,
  "name": "Mainz Vector Tiles Uebung 6",
  "sources": {
    "population": {
      "type": "vector",
      "tiles": [
        "http://localhost:8080/tiles_xyz/population/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 8,
      "maxzoom": 15
    },
    "buildings": {
      "type": "vector",
      "tiles": [
        "http://localhost:8080/tiles_xyz/buildings/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 13,
      "maxzoom": 16
    }
  },
  "layers": [
    {
      "id": "population-0",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          0
        ],
        [
          "<",
          "population",
          10
        ]
      ],
      "paint": {
        "fill-color": "#ffffcc",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-10",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          10
        ],
        [
          "<",
          "population",
          25
        ]
      ],
      "paint": {
        "fill-color": "#ffeda0",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-25",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          25
        ],
        [
          "<",
          "population",
          50
        ]
      ],
      "paint": {
        "fill-color": "#fed976",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-50",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          50
        ],
        [
          "<",
          "population",
          100
        ]
      ],
      "paint": {
        "fill-color": "#feb24c",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-100",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
          100
        ],
        [
          "<",
          "population",
          200
        ]
      ],
      "paint": {
        "fill-color": "#fd8d3c",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "population-200",
      "type": "fill",
      "source": "population",
      "source-layer": "population",
      "filter": [
        "all",
        [
          ">=",
          "population",
